{
  "name": "vitaledger-verifier",
  "version": "0.2.0",
  "description": "Reference verifier and specification for VitaLedger food-evidence records anchored on Cardano",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser/vitaledger-verifier.js",
    "./issuer": "./dist/issuer.js"
  },
  "bin": {
    "vitaledger-verify": "dist/cli.js",
    "vitaledger-issuer": "dist/issuer-cli.js"
  },
  "files": [
    "SPEC.md",
    "dist",
    "issuer-pack",
    "schema",
    "test-vectors"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:browser",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/cli.ts",
    "vectors": "tsx scripts/generate-vectors.ts",
    "build:browser": "esbuild src/browser.ts --bundle --minify --format=iife --global-name=VitaLedgerVerifier --target=es2020 --outfile=dist/browser/vitaledger-verifier.js"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wistkey/vitaledger-verifier.git"
  },
  "homepage": "https://github.com/Wistkey/vitaledger-verifier#readme",
  "bugs": {
    "url": "https://github.com/Wistkey/vitaledger-verifier/issues"
  },
  "keywords": [
    "cardano",
    "verifier",
    "merkle",
    "food-safety",
    "provenance",
    "rfc8785"
  ]
}
