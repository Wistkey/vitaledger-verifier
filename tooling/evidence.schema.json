{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wistkey/vitaledger-verifier/blob/main/tooling/evidence.schema.json",
  "title": "VitaLedger Cardano tooling evidence v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "tool", "toolVersion", "mode", "network", "startedAt", "finishedAt", "status", "assertions"],
  "properties": {
    "schema": { "const": "vitaledger.tooling-evidence.v1" },
    "tool": { "type": "string", "minLength": 1 },
    "toolVersion": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["ci", "local", "shadow-canary"] },
    "network": { "enum": ["yaci-local", "yano-local", "preprod"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "failed"] },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ok"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "recordDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "proofUrl": { "type": "string", "format": "uri" }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "txHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "metadataLabel": { "type": "integer", "minimum": 0 },
        "provider": { "type": "string" }
      }
    },
    "error": { "type": "string" }
  }
}
